# Copy to .env for local development only. Never use this password in production.
DATABASE_URL=postgres://shortlog:shortlog_dev@127.0.0.1:5432/shortlog?sslmode=disable
HTTP_ADDR=127.0.0.1:8080
# Generate locally: openssl rand -hex 32. Configure the same key in production secrets.
EMAIL_OTP_KEY=
# Hostinger SMTP over TLS on port 465.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=shortlog@zeyrie.top
SMTP_FROM=shortlog@zeyrie.top
# Set the Hostinger mailbox app password locally or in deployment secrets.
SMTP_PASSWORD=
# Create a BotFather Login Widget configuration with this exact HTTPS callback.
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=
TELEGRAM_REDIRECT_URI=
# Generate separately from EMAIL_OTP_KEY: openssl rand -hex 32.
TELEGRAM_ENCRYPTION_KEY=
